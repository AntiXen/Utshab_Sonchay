rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && me().active == true; }
    function admin() { return activeUser() && me().role == 'admin'; }
    function auditor() { return activeUser() && me().role == 'auditor'; }
    function collector() { return activeUser() && (me().role == 'admin' || me().volunteer == true); }
    function festivalOpen(festivalId) { return get(/databases/$(database)/documents/festivals/$(festivalId)).data.status == 'active'; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if admin() || auditor() || own(uid);
      allow create: if admin(); // bootstrap admin is created only by trusted callable function
      allow update: if admin() || (own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','language','updatedAt']));
      allow delete: if false;
    }
    match /festivals/{festivalId} {
      allow read: if activeUser();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /income/{incomeId} {
      allow read: if admin() || auditor() || (activeUser() && (resource.data.memberUid == request.auth.uid || resource.data.status == 'confirmed'));
      allow create: if activeUser() && festivalOpen(request.resource.data.festivalId) && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.createdBy == request.auth.uid && (request.resource.data.type == 'contribution' || (request.resource.data.type == 'pronami' && collector()));
      allow update: if admin() && resource.data.festivalId == request.resource.data.festivalId && request.resource.data.amount is int && request.resource.data.amount > 0;
      allow delete: if false;
    }
    match /payments/{paymentId} {
      allow read: if admin() || auditor() || (activeUser() && resource.data.memberUid == request.auth.uid);
      allow create, update: if false; // only Cloud Functions / Admin SDK may mutate online payment state
      allow delete: if false;
    }
    match /collectionClosings/{closingId} {
      allow read: if admin() || auditor() || (activeUser() && resource.data.collectorUid == request.auth.uid);
      allow create: if collector() && request.resource.data.collectorUid == request.auth.uid && festivalOpen(request.resource.data.festivalId);
      allow update: if admin(); allow delete: if false;
    }
    match /vendors/{vendorId} { allow read: if activeUser(); allow create, update: if admin(); allow delete: if false; }
    match /bills/{billId} {
      allow read: if admin() || auditor() || (activeUser() && (resource.data.requesterUid == request.auth.uid || resource.data.status == 'Approved' || resource.data.status == 'approved'));
      allow create: if activeUser() && festivalOpen(request.resource.data.festivalId) && request.resource.data.requesterUid == request.auth.uid && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.status == 'pending';
      allow update: if admin(); allow delete: if false;
    }
    match /billPayments/{paymentId} {
      allow read: if admin() || auditor() || (activeUser() && resource.data.requesterUid == request.auth.uid);
      allow create: if activeUser() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.status == 'pending';
      allow update: if admin(); allow delete: if false;
    }
    match /notifications/{notificationId} {
      allow read: if admin() || auditor() || (activeUser() && resource.data.userUid == request.auth.uid);
      allow create: if admin();
      allow update: if admin() || (activeUser() && resource.data.userUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']));
      allow delete: if false;
    }
    match /announcements/{id} { allow read: if activeUser(); allow create, update: if admin(); allow delete: if false; }
    match /calendarEvents/{id} { allow read: if activeUser(); allow create, update: if admin(); allow delete: if false; }
    match /auditLog/{id} { allow read: if admin() || auditor(); allow create, update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
